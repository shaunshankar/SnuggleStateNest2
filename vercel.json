{
  "rewrites": [
    { "source": "/api/households/join", "destination": "/api/households?action=join" },
    { "source": "/api/transactions/:id", "destination": "/api/transactions?id=:id" },
    { "source": "/api/bills/pay",        "destination": "/api/bills?action=pay" },
    { "source": "/api/bills/:id",        "destination": "/api/bills?id=:id" },
    { "source": "/api/savings/contribute", "destination": "/api/savings?action=contribute" },
    { "source": "/api/savings/:id",      "destination": "/api/savings?id=:id" },
    { "source": "/(.*)",                 "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/bill-reminders", "schedule": "0 8 * * *" }
  ]
}
